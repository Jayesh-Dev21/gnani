# Backend settings. Every value here can be set in the environment or in the
# repo-root .env, which this service also reads. Nothing else is read from disk.

# --- required ---------------------------------------------------------------
# Gnani API key from the Gnani APIs dashboard. The app will not start without it.
GNANI_API_KEY=

# GroqCloud key for summarisation. Without it the stack refuses to start, because a
# missing provider key should be a startup failure and not a 401 per request.
GROQ_API_KEY=

# --- where files live -------------------------------------------------------
# Root for uploaded audio. In compose this is the audio_data volume at /srv/data.

# --- object storage ---------------------------------------------------------
# Cloudflare R2, reached over its S3-compatible API. The bucket is private and
# served through short-lived signed URLs. All four R2 values are required.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gnani-bucket
R2_PRESIGN_EXPIRY_SECONDS=3600

# --- authentication ---------------------------------------------------------
# JWKS endpoint used to verify Better Auth session tokens. In compose the API
# reaches the frontend by service name, not localhost.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Must match the audience Better Auth stamps into the token, i.e. BETTER_AUTH_URL.
AUTH_AUDIENCE=http://localhost:3000
# Local-development bypass that skips token verification. Refuses to start when
# ENV=production.
ENABLE_DEV_AUTH=false
DEV_USER_ID=dev-user

# --- database ---------------------------------------------------------------
# asyncpg driver, because SQLAlchemy talks to Postgres asynchronously.
# Required by the procrastinate CLI (worker and `procrastinate schema --apply`)
PROCRASTINATE_APP=src.queue.app
PYTHONPATH=/srv

DATABASE_URL=postgresql+asyncpg://audio_notes:audio_notes@localhost:5432/audio_notes

# --- uploads ----------------------------------------------------------------
# 10 MB. This is Gnani's per-file cap for the direct multipart path used in
# development; it becomes a configuration value once storage is object storage.
MAX_UPLOAD_BYTES=10485760

# --- CORS -------------------------------------------------------------------
# Origins allowed to call this API from a browser. Must match the frontend's
# BETTER_AUTH_TRUSTED_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- speech to text ---------------------------------------------------------
GNANI_MODEL=gnani-prisma-v2.5
# Seconds to wait on the synchronous endpoint before escalating to Batch STT.
# --- summarisation ---------------------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Comma separated fallback chain, tried in this order.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Only sent to models that document it (the openai/gpt-oss family).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=700
LLM_CHUNK_CHARS=24000
LLM_MODEL_COOLDOWN_SECONDS=300

STT_REST_TIMEOUT_SECONDS=90
# How often to poll a Gnani Batch job. Their docs ask for no tighter than 10s
# (30s for big jobs); going faster earns a 429, which is waited out, not failed.
STT_POLL_INTERVAL_SECONDS=30
# A Batch job that has not finished by then is reported as a failure instead of
# holding a worker slot forever.
STT_BATCH_DEADLINE_SECONDS=900
# How long one worker's claim on a note stays valid. A note whose lease expires
# is reclaimed at the next worker start.
WORKER_LEASE_SECONDS=120
# How often a running job pushes its lease forward while it waits on Gnani.
WORKER_HEARTBEAT_SECONDS=30
# Comma separated queue names this worker drains.
WORKER_QUEUES=transcription,summarisation

# --- environment ------------------------------------------------------------
ENV=development