# Backend settings. Every value here can be set in the environment or in the
# repo-root .env, which this service also reads. Nothing else is read from disk.

# --- required ---------------------------------------------------------------
# Gnani API key from the Gnani APIs dashboard. The app will not start without it.
GNANI_API_KEY=

# --- where files live -------------------------------------------------------
# Root for uploaded audio. In compose this is the audio_data volume at /srv/data.
DATA_DIR=data

# --- authentication ---------------------------------------------------------
# JWKS endpoint used to verify Better Auth session tokens. In compose the API
# reaches the frontend by service name, not localhost.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Must match the audience Better Auth stamps into the token, i.e. BETTER_AUTH_URL.
AUTH_AUDIENCE=http://localhost:3000
# Local-development bypass that skips token verification. Refuses to start when
# ENV=production.
ENABLE_DEV_AUTH=false
DEV_USER_ID=dev-user

# --- database ---------------------------------------------------------------
# asyncpg driver, because SQLAlchemy talks to Postgres asynchronously.
DATABASE_URL=postgresql+asyncpg://audio_notes:audio_notes@localhost:5432/audio_notes

# --- uploads ----------------------------------------------------------------
# 10 MB. This is Gnani's per-file cap for the direct multipart path used in
# development; it becomes a configuration value once storage is object storage.
MAX_UPLOAD_BYTES=10485760

# --- CORS -------------------------------------------------------------------
# Origins allowed to call this API from a browser. Must match the frontend's
# BETTER_AUTH_TRUSTED_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- speech to text ---------------------------------------------------------
GNANI_MODEL=gnani-prisma-v2.5
# Seconds to wait on the synchronous endpoint before escalating to Batch STT.
STT_REST_TIMEOUT_SECONDS=90

# --- environment ------------------------------------------------------------
ENV=development