# Copy to .env and fill in the blanks. Both files are gitignored; this one is committed.

# --- frontend (Next.js) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://audio_notes:audio_notes@localhost:5432/audio_notes

# --- transcription worker ---------------------------------------------------
# Batch polling cadence. Gnani asks for 10s minimum, 30s for long jobs; polling
# faster earns a 429.
STT_POLL_INTERVAL_SECONDS=30
# Give up on a Batch job after this long rather than holding a worker slot.
STT_BATCH_DEADLINE_SECONDS=900
# A note claimed for longer than this without a heartbeat is reclaimed on the
# next worker start, so a crash cannot strand a note in transcribing.
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30

# --- Gnani ASR ----------------------------------------------------------------
# From the Gnani APIs dashboard. The app refuses to start without this key.
GNANI_API_KEY=
GNANI_MODEL=gnani-prisma-v2.5
STT_REST_TIMEOUT_SECONDS=90

# --- summarisation (GroqCloud) ---------------------------------------------
# API key from https://console.groq.com/keys. The stack refuses to start without it.
GROQ_API_KEY=
# Models to try in order. The first that answers wins; the rest are fallbacks for
# rate limits and provider errors. Checked against Groq's live model list:
# https://console.groq.com/docs/models
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# How long a model is skipped after repeated transient failures.
LLM_MODEL_COOLDOWN_SECONDS=300
# Transcript is summarised in chunks of this many characters, then reduced to one
# summary, so a long recording is never truncated.
LLM_CHUNK_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=90
