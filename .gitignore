# Shared ignore rules for the whole monorepo (app/frontend, app/backend).
# Stacked on top of git's global excludes.

# secrets & local config
.env
.env.*
!.env.example
*.pem
*.key
!.env.template

# node / next.js
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.npmrc.local
.eslintcache

# python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/

# database & object storage
*.sqlite
*.sqlite3
*.db
pgdata/

# uploads / local dev artifacts 
uploads/
tmp/
media/

# docker
docker-data/
.docker-data/
*.pid

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pip-log.txt

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp